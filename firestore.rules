rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) 
        && data.keys().size() == 5
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (data.displayName == null || data.displayName is string)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Match Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && (incoming().displayName == null || incoming().displayName is string)
        && incoming().updatedAt == request.time
      );
    }

    // Order Validation
    function isValidOrder(data) {
      return data.keys().hasAll(['name', 'phone', 'email', 'address', 'notes', 'type', 'items', 'total', 'status', 'createdAt', 'userId'])
        && data.keys().size() >= 10
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.email is string && data.email.size() <= 256
        && data.address is string && data.address.size() <= 500
        && data.type in ['delivery', 'pickup']
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.total is number && data.total >= 0
        && data.status in ['pending', 'confirmed', 'delivering', 'completed', 'cancelled']
        && data.createdAt == request.time
        && (data.userId == null || data.userId is string);
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(incoming())
        && (incoming().userId == null || isOwner(incoming().userId));
      
      allow get: if isSignedIn() && (
        (existing().userId != null && isOwner(existing().userId)) || existing().email == request.auth.token.email
      );
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow update: if isSignedIn() && isValidOrder(incoming()) && (
        // Only allow status updates or certain fields if owner
        isOwner(existing().userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status']) || 
          (existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'address']))
        )
      );
    }
  }
}
